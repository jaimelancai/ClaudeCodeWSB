# Samba configuration for ClaudeCodeWSB
# Generated by install.sh — placeholders are replaced at install time.
#
# Manual edits to this file may be overwritten if you re-run the installer.

[global]
   workgroup = WORKGROUP
   server string = ClaudeCodeWSB Dev Share
   security = user
   map to guest = never
   log file = /var/log/samba/log.%m
   max log size = 1000
   server min protocol = SMB2

   # Bind only to the WSL-internal interface to avoid colliding with anything
   # on the host network. WSL's default interface is eth0.
   # If you have issues, comment these two lines out — Samba will bind all
   # interfaces inside the VM, which is usually fine.
   bind interfaces only = yes
   interfaces = lo eth0

[__SHARE_NAME__]
   path = __WORKSPACE_PATH__
   browseable = yes
   read only = no
   guest ok = no
   valid users = __USERNAME__

   # Unity compatibility: ext4 is case-sensitive but Unity refuses case-sensitive
   # filesystems. Samba can emulate case-insensitive name resolution.
   case sensitive = no
   preserve case = yes
   short preserve case = yes

   # Allow Windows to execute DLLs and EXEs from the share. Without this,
   # Burst compiler and similar tools fail with "Access denied" when they
   # try to LoadLibrary() or CreateProcess() on files from the share.
   acl allow execute always = yes

   # File permissions for new files/directories created over SMB
   create mask = 0755
   directory mask = 0755

   # Make file attributes work reasonably with Windows
   map archive = yes
